{
  "project": "rusty-engine-demo",
  "serve": {
    "command": "RUSTY_ENGINE_DEMO_PROJECT=content/projects/doom-pickup-room.project.json bash scripts/serve-den.sh -- --host {host} --port {port}",
    "preferredPort": 37300,
    "healthUrl": "/health",
    "readyText": "\"project\":\"rusty-engine-demo\"",
    "identityHeader": "X-Den-Project",
