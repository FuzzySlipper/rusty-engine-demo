{
  "name": "rusty-engine-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "audit:boundary": "node scripts/audit-boundary.mjs",
    "build:shell": "nx build loading-bay --skip-nx-cache",
    "build:tauri": "tauri build --bundles deb,appimage",
    "build:tauri:binary": "tauri build --no-bundle",
    "certify:e1m1": "node scripts/doom-browser-smoke.mjs",
    "check:content": "pnpm --filter @rusty-engine-demo/project-content check && node scripts/check-canonical-projects.mjs",
    "gameplay:build": "tsc -p gameplay/authoring/tsconfig.json && node gameplay/authoring/scripts/materialize.mjs",
    "gameplay:check": "pnpm gameplay:build && git diff --exit-code -- data/gameplay/",
    "gameplay:typecheck": "tsc -p gameplay/authoring/tsconfig.json --noEmit",
    "generate:content": "pnpm --filter @rusty-engine-demo/project-content generate",
    "lint": "nx run-many -t lint --all",
    "serve:den": "bash scripts/serve-den.sh",
    "smoke:e1m1": "RUSTY_DOOM_SMOKE_FOCUSED=1 node scripts/doom-browser-smoke.mjs",
    "smoke:tauri": "node scripts/tauri-smoke.mjs",
    "smoke:tauri:headed": "pnpm run build:tauri:binary && node scripts/tauri-headed-smoke.mjs",
    "test:engine-route": "node --test apps/loading-bay/src/engine-application.test.ts",
    "test:platform": "node --test libs/platform/src/*.test.ts",
    "test:shell": "pnpm --filter @rusty-engine-demo/browser-shell test",
    "test:tauri": "pnpm run build:shell && cargo test --locked -p loading-bay-desktop",
    "test:ts": "pnpm --filter @rusty-engine-demo/project-content test",
    "typecheck": "tsc --build ts/tsconfig.json && pnpm --filter @rusty-engine-demo/browser-shell typecheck && nx run-many -t typecheck --all",
    "verify": "bash scripts/verify.sh",
    "verify:tauri": "pnpm run test:tauri && pnpm run build:tauri:binary && pnpm run smoke:tauri"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@rusty-engine/application-host": "file:../rusty-engine/render/artifacts/application-host",
    "@rusty-engine/gameplay-standard-authoring": "file:../rusty-engine/rules/packages/gameplay-standard-authoring",
    "@rusty-engine/gameplay-standard-contracts": "file:../rusty-engine/rules/packages/gameplay-standard-contracts",
    "@rusty-engine/gameplay-rules-authoring": "file:../rusty-engine/rules/packages/gameplay-rules-authoring",
    "@rusty-engine/gameplay-rules-contracts": "file:../rusty-engine/rules/packages/gameplay-rules-contracts",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@angular/build": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^9.39.4",
    "@nx/angular": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@types/node": "25.9.2",
    "@typescript-eslint/utils": "^8.61.1",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
