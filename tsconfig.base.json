{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@rusty-engine-demo/game-runtime": [
        "ts/packages/browser-shell/src/game-runtime.ts"
      ],
      "@rusty-engine-demo/platform": ["libs/platform/src/index.ts"],
      "@rusty-engine-demo/studio-weapon-inspector": [
        "libs/studio-weapon-inspector/src/index.ts"
      ],
      "@rusty-engine-demo/ui-combat-log": ["libs/ui-combat-log/src/index.ts"],
      "@rusty-engine-demo/ui-compass": ["libs/ui-compass/src/index.ts"],
      "@rusty-engine-demo/ui-game-panels": ["libs/ui-game-panels/src/index.ts"]
    }
  }
}
